From: bakedsnake <bakedsnake@vagrantz.xyz>
Date: Thu, 24 Sep 2026 20:40:55 +0200
Subject: [PATCH] Use system libs instead of vendored code

* admesh
* expat
* exprtk
* miniz
---
--- a/Build.PL
+++ b/Build.PL
@@ -166,6 +166,23 @@ if (! $mswin) {
         );
 }

+if (! $mswin) {
+#    die <<'EOF' unless check_lib(lib => "admesh");
+#Could not find admesh. Plase install.
+#EOF
+    push @LIBS, "-lm -ladmesh";
+
+    die <<'EOF' unless check_lib(lib => "expat");
+Could not find expat. Plase install.
+EOF
+    push @LIBS, "-lexpat";
+
+    die <<'EOF' unless check_lib(lib => "miniz");
+Could not find libexpat. Plase install.
+EOF
+    push @LIBS, "-lminiz";
+}
+
 if (!$ENV{SLIC3R_STATIC} && $have_boost) {
     # The boost library was detected by check_lib on Linux.
     push @LIBS, map "-lboost_${_}", @boost_libraries;
