+  if ( gfortran_compiler AND ( NOT CMAKE_Fortran_COMPILER_VERSION VERSION_LESS 16.0.0 ) )
+    add_definitions(-DGCC_GE_16) # Tell library to build against GFortran 16.x bindings
+  endif()
 
