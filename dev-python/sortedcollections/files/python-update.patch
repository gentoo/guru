From 06e867edeeb1a3708bc2aa804c3f7f79e3cdcf77 Mon Sep 17 00:00:00 2001
From: bakedsnake <bakedsnake@vagrantz.xyz>
Date: Mon, 2 Nov 2026 11:48:33 +0100
Subject: [PATCH] add newer python versions {10..15}

---
 pyproject.toml                    |  3 +++
 setup.py                          | 31 ++++++++++---------------------

diff --git a/pyproject.toml b/pyproject.toml
new file mode 100644
index 0000000..09977b5
--- /dev/null
+++ b/pyproject.toml
@@ -0,0 +1,3 @@
+[build-system]
+requires = ["setuptools>=61"]
+build-backend = "setuptools.build_meta"
diff --git a/setup.py b/setup.py
index 6bf001f..872e55a 100644
--- a/setup.py
+++ b/setup.py
@@ -2,21 +2,6 @@ import pathlib
 import re

 from setuptools import setup
-from setuptools.command.test import test as TestCommand
-
-
-class Tox(TestCommand):
-    def finalize_options(self):
-        TestCommand.finalize_options(self)
-        self.test_args = []
-        self.test_suite = True
-
-    def run_tests(self):
-        import tox
-
-        errno = tox.cmdline(self.test_args)
-        exit(errno)
-

 with open('README.rst') as reader:
     readme = reader.read()
@@ -33,22 +18,26 @@ setup(
     author='Grant Jenks',
     author_email='contact@grantjenks.com',
     url='http://www.grantjenks.com/docs/sortedcollections/',
-    license='Apache 2.0',
+    license='Apache-2.0',
     packages=['sortedcollections'],
     install_requires=['sortedcontainers'],
-    tests_require=['tox'],
-    cmdclass={'test': Tox},
-    classifiers=(
+    python_requires='>=3.6',
+    classifiers=[
         'Development Status :: 5 - Production/Stable',
         'Intended Audience :: Developers',
-        'License :: OSI Approved :: Apache Software License',
         'Natural Language :: English',
         'Programming Language :: Python',
         'Programming Language :: Python :: 3.6',
         'Programming Language :: Python :: 3.7',
         'Programming Language :: Python :: 3.8',
         'Programming Language :: Python :: 3.9',
+        'Programming Language :: Python :: 3.10',
+        'Programming Language :: Python :: 3.11',
+        'Programming Language :: Python :: 3.12',
+        'Programming Language :: Python :: 3.13',
+        'Programming Language :: Python :: 3.14',
+        'Programming Language :: Python :: 3.15',
         'Programming Language :: Python :: Implementation :: CPython',
         'Programming Language :: Python :: Implementation :: PyPy',
-    ),
+    ],
 )
