inherit cargo

RUST_MIN_VER="1.88.0"

DESCRIPTION="OpenStack client rewritten in Rust"
HOMEPAGE="https://github.com/gtema/openstack"
SRC_URI="
	https://github.com/gtema/openstack/archive/refs/tags/v${PV}.tar.gz -> ${P}.tar.gz
	${CARGO_CRATE_URIS}
"

# The repository's root directory is a "workspace root".
# It's easier and less error prone to work in src/main.
#S="${WORKDIR}/openstack-${PV}/openstack_cli"
S="${WORKDIR}/openstack-${PV}/"

LICENSE="Apache-2.0"
# Dependent crate licenses
LICENSE+="
	Apache-2.0 BSD CC-BY-4.0 CC0-1.0 CDLA-Permissive-2.0 ISC MIT MPL-2.0
	UoI-NCSA openssl Unicode-3.0 Unicode-DFS-2016 WTFPL-2 ZLIB
"
SLOT="0"
KEYWORDS="~amd64 ~arm64"
IUSE="+cli tui"
REQUIRED_USE="|| ( cli tui )"

DEPEND="
	dev-libs/openssl:0=
"

RDEPEND="${DEPEND}"

BDEPEND="virtual/pkgconfig"

src_configure() {
	# Required for pkg-config crate:
	#   https://wiki.gentoo.org/wiki/Writing_Rust_ebuilds#pkg-config_crate
	export PKG_CONFIG_ALLOW_CROSS=1

	# Un-bundle OpenSSL:
	#   https://wiki.gentoo.org/wiki/Writing_Rust_ebuilds#Common_-sys_crates
	export OPENSSL_NO_VENDOR=1

	rust_pkg_setup

	if use cli; then
		local S=${S}/openstack_cli

		# Cannot set myfeatures here:
		#  - myfeatures gets read into ECARGO_ARGS whichis a readonly variable,
		#    so inherently it's the same for both cli and tui.
		#  - But having a bunch of features in ECARGO_ARGS causes tui to fail
		#    to build, since tui does not have any features.
		cargo_src_configure
	fi
}

src_compile() {
	if use cli; then
		#cargo_src_compile --bin osc
		cargo_src_compile --package openstack_cli
	fi

	if use tui; then
		#cargo_src_compile --bin ostui
		cargo_src_compile --package openstack_tui
	fi
}

src_install() {
	if use cli; then
		cargo_src_install --path ./openstack_cli
	fi

	if use tui; then
		cargo_src_install --path ./openstack_tui
	fi
}

src_test() {
	if use cli; then
		cargo_src_test
	fi
}
