inherit cargo shell-completion

RUST_MIN_VER="1.91.0"

DESCRIPTION="OpenStack client rewritten in Rust"
HOMEPAGE="https://github.com/gtema/openstack"
SRC_URI="
	https://github.com/gtema/openstack/archive/refs/tags/v${PV}.tar.gz -> ${P}.tar.gz
	${CARGO_CRATE_URIS}
"

S="${WORKDIR}/openstack-${PV}/"

LICENSE="Apache-2.0"
# Dependent crate licenses
LICENSE+="
	Apache-2.0 Apache-2.0-with-LLVM-exceptions BSD CC0-1.0
	CDLA-Permissive-2.0 ISC MIT MIT-0 MPL-2.0 MPL-2.0 UoI-NCSA
	Unicode-3.0 Unicode-DFS-2016 WTFPL-2 ZLIB
"

SLOT="0"
KEYWORDS="~amd64 ~arm64"

DEPEND="dev-libs/openssl"

# Required to deal with a bug in 0.13.8 with USE="debug". The debug binary
# crashes when generating the shell completions. It's been reported to and
# fixed by upstream since, which is where this patch originates from. See
#
#   https://github.com/gtema/openstack/issues/1988
PATCHES=(
	"${FILESDIR}/0001-fix-cli-Disable-auto-version-flag-on-plugin-subcomma.patch"
)

src_compile() {
	# Required for pkg-config crate:
	#   https://wiki.gentoo.org/wiki/Writing_Rust_ebuilds#pkg-config_crate
	export PKG_CONFIG_ALLOW_CROSS=1

	# Un-bundle OpenSSL:
	#   https://wiki.gentoo.org/wiki/Writing_Rust_ebuilds#Common_-sys_crates
	export OPENSSL_NO_VENDOR=1

	cargo_src_compile --package openstack_cli

	local bin_path="${S}/$(cargo_target_dir)/osc"
	"${bin_path}" completion bash > osc || die
	"${bin_path}" completion zsh > _osc || die
	"${bin_path}" completion fish > osc.fish || die
}

src_install(){
	cargo_src_install --path ./openstack_cli

	dobashcomp osc
	dozshcomp _osc
	dofishcomp osc.fish
}

src_test(){
	# Reported upstream:
	#   https://github.com/gtema/openstack/issues/1984
	local CARGO_SKIP_TESTS=(
		test_scoped_login_does_not_trigger_redundant_reauth
		test_version_discovery_404_fails
	)
	cargo_src_test
}
