[Unit]
Description=A Matrix-Telegram Messenger puppeting bridge
After=network.target

[Service]
Type=exec
User=mautrix-telegram
Group=mautrix
ExecStart=/usr/bin/mautrix-telegram -c /etc/mautrix/mautrix_telegram.yaml -r /var/lib/mautrix/telegram/registration.yaml
Restart=on-failure
RestartSec=30s

[Install]
WantedBy=multi-user.target
