inherit cargo desktop optfeature xdg

DESCRIPTION="A native WhatsApp client built with Rust and egui"
HOMEPAGE="https://zapfast.rocks"
SRC_URI="
	https://github.com/crmne/zapfast/archive/refs/tags/v${PV}.tar.gz -> ${P}.tar.gz
	${CARGO_CRATE_URIS}
"

LICENSE="MIT"
# Dependent crate licenses
LICENSE+="
	0BSD Apache-2.0 Apache-2.0-with-LLVM-exceptions BSD-2 BSD Boost-1.0
	CC0-1.0 CDLA-Permissive-2.0 ISC MIT MIT-0 MPL-2.0 Unicode-3.0
	Unlicense ZLIB
"
SLOT="0"
KEYWORDS="~amd64"

IUSE="test"
RESTRICT="!test? ( test )"

BDEPEND="
	dev-build/cmake
	dev-lang/perl
	llvm-core/clang
	test? ( media-fonts/liberation-fonts )
	virtual/pkgconfig
"
DEPEND="
	dev-libs/wayland
	media-libs/alsa-lib
	media-libs/libglvnd
	media-video/pipewire:=
	x11-libs/libX11
	x11-libs/libXcursor
	x11-libs/libXi
	x11-libs/libXrandr
	x11-libs/libxcb
	x11-libs/libxkbcommon[X]
"
RDEPEND="${DEPEND}"

src_configure() {
	export PKG_CONFIG_ALLOW_CROSS=1
	cargo_src_configure
}

src_prepare() {
	default

	local crate crate_patches crate_uri commit crate_dir host
	for crate in "${!GIT_CRATES[@]}"; do
		IFS=';' read -r crate_uri commit crate_dir host <<< "${GIT_CRATES[${crate}]}"
		: "${crate_dir:=${crate}-%commit%}"
		crate_patches+="${crate} = { path = \"${WORKDIR}/${crate_dir//%commit%/${commit}}\" };;"
	done
	printf -- "[patch.crates-io]\\n%s" "${crate_patches//;;/$'\n'}" \
		>> "${CARGO_HOME}/config.toml"
}

src_install() {
	cargo_src_install

	domenu packaging/applications/${PN}.desktop
	newicon docs/assets/images/logo.svg ${PN}.svg

	dodoc THIRD-PARTY-NOTICES.md README.md
}

pkg_postinst() {
	xdg_pkg_postinst

	optfeature "archive encryption key storage via Secret Service" virtual/secret-service
	optfeature "colour emoji in messages and reactions" media-fonts/noto-emoji
	optfeature "file picker for attachments" sys-apps/xdg-desktop-portal
}
