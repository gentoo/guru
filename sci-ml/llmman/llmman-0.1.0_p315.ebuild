inherit cargo go-module systemd

DESCRIPTION="Local model runner serving the Ollama, OpenAI and Anthropic APIs"
HOMEPAGE="https://github.com/llmmanorg/llmman"

# Upstream tags releases as bNNN while Cargo.toml stays at 0.1.0.
MY_PV="b${PV##*_p}"
SRC_URI="
	https://github.com/llmmanorg/${PN}/archive/refs/tags/${MY_PV}.tar.gz -> ${P}.gh.tar.gz
	https://github.com/llmmanorg/${PN}/releases/download/${MY_PV}/${P}-deps.tar.xz
	${CARGO_CRATE_URIS}
"
S="${WORKDIR}/${PN}-${MY_PV}"

LICENSE="Apache-2.0"
# Dependent crate and Go module licenses
LICENSE+="
	Apache-2.0 BSD-2 BSD CDLA-Permissive-2.0 ISC MIT MPL-2.0 Unicode-3.0
	Unlicense ZLIB
"
SLOT="0"
KEYWORDS="~amd64"
# tests/launch_e2e.rs needs network access and third-party tools
RESTRICT="test"

RDEPEND="
	acct-group/${PN}
	acct-user/${PN}
"

src_unpack() {
	# cargo_src_unpack also extracts ${P}-deps.tar.xz into ${WORKDIR}/go-mod,
	# which is the GOMODCACHE build.rs uses when it runs `go build` on go-shim/.
	cargo_src_unpack
	go-env_set_compile_environment
}

src_install() {
	cargo_src_install

	newinitd "${FILESDIR}/${PN}.init" "${PN}"
	newconfd "${FILESDIR}/${PN}.confd" "${PN}"

	systemd_dounit "${FILESDIR}/${PN}.service"
}

pkg_preinst() {
	keepdir /var/log/llmman
	fperms 750 /var/log/llmman
	fowners "${PN}:${PN}" /var/log/llmman
}

pkg_postinst() {
	elog "llmman serve listens on 127.0.0.1:17434 (override with LLMMAN_HOST) and"
	elog "speaks the Ollama, OpenAI and Anthropic APIs. GGUF models are run with"
	elog "llama-server, taken from PATH if present, otherwise a prebuilt release is"
	elog "downloaded into the llmman user's data directory on first use."
}
