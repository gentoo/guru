inherit cargo shell-completion systemd

DESCRIPTION="Scan logs and take action"
HOMEPAGE="https://reaction.ppom.me"
SRC_URI="
	https://framagit.org/ppom/${PN}/-/archive/v${PV}/${PN}-v${PV}.tar.gz
	${CARGO_CRATE_URIS}
"
S="$WORKDIR/${PN}-v${PV}"

LICENSE="AGPL-3"
# Dependent crate licenses
LICENSE+="
	Apache-2.0 Apache-2.0-with-LLVM-exceptions BSD-2 BSD
	CDLA-Permissive-2.0 GPL-2 ISC MIT Unicode-3.0 Unlicense ZLIB
"
SLOT="0"
KEYWORDS="~amd64"
RUST_MIN_VER="1.91.0"
QA_FLAGS_IGNORED="/usr/bin/${PN}"

src_prepare() {
	#Install man & completions regardless of profile
	sed -i 's/var_os(.PROFILE.).*/true {/' \
		"${S}/build.rs" || die "sed build.rs failed"
	default
}

src_test() {
	#Issue https://framagit.org/ppom/reaction/-/work_items/153
	rm "${S}/tests/plugin_virtual.rs"
	default
}

src_install() {
	cargo_src_install
	local target_dir="$(cargo_target_dir)"
	newbashcomp ${target_dir}/${PN}.bash ${PN}
	dofishcomp ${target_dir}/${PN}.fish
	dozshcomp ${target_dir}/_${PN}
	systemd_dounit "${FILESDIR}/systemd/${PN}.service"
	doman ${target_dir}/*.[0-9]
	doinitd "${FILESDIR}/init.d/${PN}"
	keepdir /var/lib/${PN}
	keepdir /etc/${PN}.d
}
