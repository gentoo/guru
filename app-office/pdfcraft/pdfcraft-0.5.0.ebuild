inherit cargo

DESCRIPTION="Accessibility: the Accessibility Checker (32 rules), its report and fixes"
HOMEPAGE="https://getartcraft.com/"
SRC_URI="
	${CARGO_CRATE_URIS}
	https://github.com/storytold/pdfcraft/archive/refs/tags/v${PV}.tar.gz -> ${P}.tar.gz
"

LICENSE="|| ( Apache-2.0 MIT )"
# Dependent crate licenses
LICENSE+="
	Apache-2.0 BSD-2 BSD Boost-1.0 ISC MIT OFL-1.1 UbuntuFontLicense-1.0
	Unicode-3.0 ZLIB
"
SLOT="0"
KEYWORDS="~amd64"

src_test(){
	CARGO_SKIP_TESTS=(
		assets::tests::the_real_manifest_passes
	)
	default
}

src_install() {
	local app
	for app in pdfcraft pdfcraft-cli; do
		cd "${S}/apps/${app}" || die
		cargo_src_install
	done
	cd "${S}" || die
	einstalldocs
}
