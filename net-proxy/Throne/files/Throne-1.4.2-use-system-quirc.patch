From: Pavel Sobolev <contact@paveloom.dev>
Subject: [PATCH] Use system `quirc`

Signed-off-by: Pavel Sobolev <contact@paveloom.dev>

--- a/3rdparty/QrDecoder.cpp
+++ b/3rdparty/QrDecoder.cpp
@@ -1,10 +1,9 @@
 #include "QrDecoder.h"
 
-#include "quirc/quirc.h"
 #include <cstring>
 #include <qdebug.h>
 
-#include "quirc/quirc_internal.h"
+#include <quirc.h>
 
 QrDecoder::QrDecoder()
     : m_qr(quirc_new())
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -128,11 +128,6 @@ set(PROJECT_SOURCES
         3rdparty/qv2ray/v2/ui/LogHighlighter.cpp
         3rdparty/qv2ray/v2/ui/QvAutoCompleteTextEdit.cpp
 
-        3rdparty/quirc/decode.c
-        3rdparty/quirc/identify.c
-        3rdparty/quirc/quirc.c
-        3rdparty/quirc/version_db.c
-
         3rdparty/monocypher/monocypher.c
         3rdparty/monocypher/monocypher.h
 
@@ -934,6 +929,7 @@ target_link_libraries(Throne PRIVATE
         Threads::Threads
         ${NKR_EXTERNAL_TARGETS}
         ${PLATFORM_LIBRARIES}
+        quirc
 )
 
 qt_finalize_executable(Throne)
