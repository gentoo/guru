supervisor="supervise-daemon"
name="Snowflake Proxy"
command="/usr/bin/snowflake-proxy"
command_args="${SNOWFLAKE_PROXY_OPTS}"
command_user="nobody:nobody"

error_log="/tmp/${RC_SVCNAME}.log"

depend() {
	use net
}
